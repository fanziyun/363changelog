{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "更新日志模组 - 在标题界面与暂停界面展示整合包更新日志",
  "authors": ["FanZiyun"],
  "contact": {
    "homepage": "https://github.com/fanziyun/363changelog",
    "sources": "https://github.com/fanziyun/363changelog"
  },
  "license": "${mod_license}",
  "icon": "assets/changelog363/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.github.fanziyun.fabric.ChangelogFabric"
    ],
    "modmenu": [
      "com.github.fanziyun.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "${mod_id}.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version_min}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "cloth-config": "*",
    "modmenu": "*"
  }
}
